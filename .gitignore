# =============================================================
# Obsidian 볼트 백업용 .gitignore — 화이트리스트 방식
#
# 블랙리스트(제외할 것만 나열)는 새 파일이 생기면 그대로 새어나간다.
# 그래서 기본을 "전부 차단"으로 두고, 노트/이미지/문서만 열어준다.
# 새 확장자를 올리고 싶으면 아래 허용 목록에 추가할 것.
# =============================================================

# ── 1) 일단 전부 제외 ────────────────────────────────────────
*

# ── 2) 디렉터리는 탐색 허용 ─────────────────────────────────
# (이게 없으면 git이 하위 폴더로 내려가지 않아 허용 규칙이 무의미해짐)
!*/

# ── 3) 노트 ─────────────────────────────────────────────────
!*.md
!*.canvas

# ── 4) 이미지 ───────────────────────────────────────────────
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.webp
!*.svg
!*.bmp

# ── 5) 문서 첨부 ────────────────────────────────────────────
!*.pdf
!*.docx
!*.doc
!*.pptx
!*.ppt
!*.xlsx
!*.xls
!*.hwp
!*.hwpx

# ── 6) 저장소 자체 파일 ─────────────────────────────────────
!.gitignore


# =============================================================
# 아래는 위 허용 규칙을 덮어쓰는 강제 차단 (나중 규칙이 이김)
# =============================================================

# Obsidian 앱 설정 · 플러그인 (사용자 선택으로 제외)
.obsidian/

# AI 도구 대화 로그 · 로컬 설정
.claude/
.claudian/

# Python / Node 빌드 산출물
.venv/
venv/
env/
__pycache__/
node_modules/
*.pyc
*.pyo

# 시크릿 — 확장자 화이트리스트로 이미 막히지만 이중 방어
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credential*
*secret*

# 본문에 실제 API 키가 적혀 있는 노트
# 키 문자열을 지운 뒤 이 두 줄을 삭제하면 백업에 포함된다.
/무제 6.md
/1. Daily/2603/2026-03-09.md
